---
import { getCollection } from 'astro:content';
import { CATEGORY_LABELS, categoriesWithPosts } from '../../utils/categories';

interface Props {
  active?: string;
}

const { active } = Astro.props;

// Only surface categories that actually have posts. `app-updates` has none, and
// linking it shipped an indexed, empty "No articles yet" page to Google.
const categories = categoriesWithPosts(await getCollection('blog'));

const activeClasses = 'px-4 py-2 rounded-full text-sm font-medium bg-[var(--color-primary)] text-[var(--color-text-dark)]';
const inactiveClasses = 'px-4 py-2 rounded-full text-sm font-medium bg-[var(--color-surface)] text-[var(--color-text-muted)] hover:text-[var(--color-text)] hover:bg-[var(--color-elevated)] transition-colors border border-[var(--color-border)]/50';
---

<div class="flex flex-wrap gap-2 mb-10">
  <a href="/poopcheck-blog/" class={!active ? activeClasses : inactiveClasses}>
    All
  </a>
  {categories.map((slug) => (
    <a
      href={`/poopcheck-blog/category/${slug}/`}
      class={active === slug ? activeClasses : inactiveClasses}
    >
      {CATEGORY_LABELS[slug]}
    </a>
  ))}
</div>

---
import { categoryLabel } from '../../utils/categories';

interface Props {
  title: string;
  description: string;
  date: Date;
  category: string;
  slug: string;
  image?: string;
  featured?: boolean;
}

// Only a real illustration from frontmatter is shown. The generated card is a
// title graphic for social feeds; rendering it here would print the title twice.
const { title, description, date, category, slug, image, featured } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article class="group gradient-border p-0 overflow-hidden hover:bg-[var(--color-elevated)] transition-colors">
  {image && (
    <div class="aspect-[1200/630] overflow-hidden">
      <img
        src={image}
        alt={title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
        loading="lazy"
        decoding="async"
      />
    </div>
  )}
  <div class="p-6">
    <div class="flex items-center gap-3 mb-3">
      <a
        href={`/poopcheck-blog/category/${category}/`}
        class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-[var(--color-primary)]/10 text-[var(--color-primary)]"
      >
        {categoryLabel(category)}
      </a>
      <span class="text-xs text-[var(--color-text-muted)]">{formattedDate}</span>
    </div>
    <h3 class="font-semibold text-lg mb-2 group-hover:text-[var(--color-primary)] transition-colors">
      <a href={`/poopcheck-blog/${slug}/`} class="after:absolute after:inset-0 relative">
        {title}
      </a>
    </h3>
    <p class="text-sm text-[var(--color-text-muted)] leading-relaxed line-clamp-3">
      {description}
    </p>
  </div>
</article>

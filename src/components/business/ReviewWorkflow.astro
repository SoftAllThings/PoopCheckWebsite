---
// App → AI labeling → human review → training data, with corrections looping
// back into the model. Workflow only, no counts. The review step must stay
// described as our internal team (non-medical, not clinicians) and never as
// covering "every" photo — see the methodology card on /business/data.
interface Props {
  title?: string;
  intro?: string;
  class?: string;
}

const {
  title = 'AI labels at scale. People check the work.',
  intro = 'Three AI models label each photo. Our team then reviews photos, removes the unusable ones and corrects labels, and those corrections go back into training.',
  class: className,
} = Astro.props;

const ICONS = {
  phone: '<rect x="7" y="2.5" width="10" height="19" rx="2.5"/><path d="M11 18.5h2"/>',
  ai: '<path d="M11 3l1.8 4.7 4.7 1.8-4.7 1.8L11 16l-1.8-4.7L4.5 9.5l4.7-1.8z"/><path d="M18 14.5l.8 2.2 2.2.8-2.2.8-.8 2.2-.8-2.2-2.2-.8 2.2-.8z"/>',
  human: '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c.8-3.6 3.4-5.5 6.5-5.5s5.7 1.9 6.5 5.5"/><path d="M15.5 11.5l2 2 4-4"/>',
  data: '<ellipse cx="12" cy="5.5" rx="7" ry="2.5"/><path d="M5 5.5v6c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5v-6"/><path d="M5 11.5v6c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5v-6"/>',
};

const steps: { title: string; desc: string; icon: keyof typeof ICONS; tag?: string; human?: boolean }[] = [
  {
    title: 'PoopCheck app',
    desc: 'People photograph their stool at home and add daily context.',
    icon: 'phone',
  },
  {
    title: 'AI labeling',
    desc: 'Three models label Bristol type, color, blood, mucus and more, each with a confidence score.',
    icon: 'ai',
  },
  {
    title: 'Human review',
    tag: 'Non-medical',
    desc: 'Our team removes unusable photos and corrects the labels the models got wrong.',
    icon: 'human',
    human: true,
  },
  {
    title: 'Training data',
    desc: 'Reviewed photos and corrected labels are what our in-house model learns from.',
    icon: 'data',
  },
];
---

<section class:list={['review-flow', className]} aria-labelledby="review-flow-title">
  <div class="max-w-3xl mb-10">
    <p class="kicker">How our labels are made</p>
    <h2 id="review-flow-title" class="text-2xl md:text-3xl font-bold mb-3">{title}</h2>
    <p class="text-[var(--color-text-muted)] leading-relaxed">{intro}</p>
  </div>

  <div class="flow">
    <ol class="steps">
      {steps.map((step) => (
        <li class:list={['step', { 'step-human': step.human }]}>
          <span class="node-wrap">
            <span class="node">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={ICONS[step.icon]}
              />
            </span>
          </span>
          <div class="step-text">
            <h3 class="step-title">
              {step.title}
              {step.tag && <span class="tag">{step.tag}</span>}
            </h3>
            <p>{step.desc}</p>
          </div>
        </li>
      ))}
    </ol>
    <!-- After the steps in reading order; drawn as an arc back to AI labeling on wide screens -->
    <p class="loop">
      <span class="loop-label">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 11a8 8 0 0 0-14.3-4.9L4 8"/><path d="M4 3v5h5"/><path d="M4 13a8 8 0 0 0 14.3 4.9L20 16"/><path d="M20 21v-5h-5"/>
        </svg>
        Corrections retrain our model
      </span>
    </p>
  </div>
</section>

<style>
  .review-flow {
    --flow-dim: color-mix(in srgb, var(--color-accent) 30%, transparent);
    --flow-bright: var(--color-primary);
    --node-box: 72px;
    --step-gap: 1.5rem;
  }

  .kicker {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.75rem;
  }

  .flow {
    position: relative;
    padding-top: 4rem;
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--step-gap);
  }

  .step {
    position: relative;
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 1rem;
    text-align: center;
    min-width: 0;
  }

  /* Connector from this node to the next one; a highlight runs along it */
  .step:not(:last-child)::after {
    content: '';
    position: absolute;
    top: calc(var(--node-box) / 2 - 1px);
    left: calc(50% + var(--node-box) / 2 + 4px);
    width: calc(100% + var(--step-gap) - var(--node-box) - 8px);
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--flow-dim) 0%, var(--flow-bright) 50%, var(--flow-dim) 100%);
    background-size: 200% 100%;
    animation: flow 3.2s linear infinite;
  }

  .step:not(:last-child)::before {
    content: '';
    position: absolute;
    top: calc(var(--node-box) / 2 - 4px);
    left: calc(150% + var(--step-gap) - var(--node-box) / 2 - 12px);
    width: 8px;
    height: 8px;
    border-top: 2px solid var(--color-primary);
    border-right: 2px solid var(--color-primary);
    transform: rotate(45deg);
  }

  @keyframes flow {
    from { background-position: 100% 0; }
    to { background-position: -100% 0; }
  }

  .node-wrap {
    width: var(--node-box);
    height: var(--node-box);
    display: grid;
    place-items: center;
  }

  .node {
    position: relative;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: var(--color-text);
    border: 1px solid transparent;
    background:
      linear-gradient(var(--color-surface), var(--color-surface)) padding-box,
      linear-gradient(135deg, var(--color-accent), var(--color-primary)) border-box;
  }

  .node svg {
    width: 24px;
    height: 24px;
  }

  /* The human step is the focal point: larger node, primary glow, slow pulse */
  .step-human .node {
    width: var(--node-box);
    height: var(--node-box);
    border-width: 2px;
    color: var(--color-primary);
    box-shadow:
      0 0 24px color-mix(in srgb, var(--color-primary) 22%, transparent),
      0 0 64px color-mix(in srgb, var(--color-primary) 8%, transparent);
  }

  .step-human .node svg {
    width: 30px;
    height: 30px;
  }

  .step-human .node::after {
    content: '';
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--color-primary) 50%, transparent);
    animation: pulse 2.8s ease-out infinite;
  }

  @keyframes pulse {
    from { transform: scale(0.94); opacity: 0.9; }
    to { transform: scale(1.3); opacity: 0; }
  }

  .step-text {
    display: grid;
    gap: 0.375rem;
    justify-items: center;
  }

  .step-title {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 1.125rem;
    font-weight: 600;
  }

  .step-human .step-title {
    color: var(--color-primary);
  }

  .tag {
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.125rem 0.5rem;
  }

  .step p {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    max-width: 26ch;
  }

  /* Arc from the Training data node back to AI labeling (2nd → 4th column centres) */
  .loop {
    position: absolute;
    top: 1rem;
    left: calc(37.5% - var(--step-gap) / 8);
    width: calc(50% + var(--step-gap) / 2);
    height: calc(3rem + 6px);
    margin: 0;
    border: 2px dashed color-mix(in srgb, var(--color-primary) 55%, transparent);
    border-bottom: none;
    border-radius: 1.25rem 1.25rem 0 0;
  }

  .loop::after {
    content: '';
    position: absolute;
    left: -6px;
    bottom: 1px;
    width: 10px;
    height: 10px;
    border-right: 2px solid var(--color-primary);
    border-bottom: 2px solid var(--color-primary);
    transform: rotate(45deg);
  }

  .loop-label {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translate(-50%, -50%);
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    white-space: nowrap;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-primary);
    background: var(--color-bg);
    border: 1px solid color-mix(in srgb, var(--color-primary) 35%, transparent);
    border-radius: 999px;
    padding: 0.25rem 0.75rem;
  }

  .loop-label svg {
    width: 14px;
    height: 14px;
  }

  @media (max-width: 767px) {
    .flow {
      padding-top: 0;
    }

    .steps {
      grid-template-columns: minmax(0, 1fr);
    }

    .step {
      grid-template-columns: var(--node-box) minmax(0, 1fr);
      justify-items: start;
      column-gap: 1rem;
      text-align: left;
    }

    .step-text,
    .step-title {
      justify-items: start;
      justify-content: flex-start;
    }

    .step-text {
      padding-top: 0.75rem;
    }

    .step:not(:last-child)::after {
      top: calc(var(--node-box) + 6px);
      left: calc(var(--node-box) / 2 - 1px);
      width: 2px;
      height: calc(100% - var(--node-box) - 12px + var(--step-gap));
      background: linear-gradient(180deg, var(--flow-bright), var(--flow-dim));
      animation: none;
    }

    .step:not(:last-child)::before {
      display: none;
    }

    .loop {
      position: static;
      width: auto;
      height: auto;
      border: none;
      margin-top: 1.5rem;
    }

    .loop::after {
      display: none;
    }

    .loop-label {
      position: static;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .step::after,
    .step-human .node::after {
      animation: none;
    }
  }
</style>

---
import { SITE } from '../../utils/seo';

/**
 * Presents a chart alongside a copy-paste embed snippet.
 *
 * The snippet carries a followed link back to the source page. This is the
 * mechanism by which a genuinely useful chart earns links passively — every
 * blog or forum that reuses the image cites us. Without the snippet, people
 * hotlink or re-upload the image with no attribution and we get nothing.
 */
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  title: string;
  caption?: string;
  /** Page the embed should credit. Site-relative. */
  creditPath: string;
  eager?: boolean;
  /** Light-theme variant for printing. Rendered as a real <img> so it is indexable. */
  printable?: { src: string; width: number; height: number };
}

const { src, alt, width, height, title, caption, creditPath, eager = false, printable } = Astro.props;

const imageUrl = `${SITE.url}${src}`;
const creditUrl = `${SITE.url}${creditPath}`;

const embedCode = `<a href="${creditUrl}"><img src="${imageUrl}" alt="${alt}" width="${width}" height="${height}" style="max-width:100%;height:auto" /></a>
<p>Source: <a href="${creditUrl}">${title} by ${SITE.name}</a></p>`;
---

<section class="my-14">
  <figure class="m-0">
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      fetchpriority={eager ? 'high' : 'auto'}
      class="w-full h-auto rounded-2xl border border-white/8"
    />
    {caption && (
      <figcaption class="mt-3 text-sm text-[var(--color-text-muted)] leading-relaxed text-center">
        {caption}
      </figcaption>
    )}
  </figure>

  <details class="mt-6 rounded-2xl border border-[var(--color-border)]/50 bg-[var(--color-surface)] overflow-hidden">
    <summary class="cursor-pointer select-none px-5 py-4 text-sm font-semibold hover:text-[var(--color-primary)] transition-colors">
      Use this chart on your site — free, just credit us
    </summary>
    <div class="px-5 pb-5">
      <p class="text-sm text-[var(--color-text-muted)] mb-3">
        Copy the snippet below. You're welcome to republish this chart anywhere as
        long as the attribution link stays intact.
      </p>
      <textarea
        readonly
        rows="4"
        id={`embed-${creditPath.replace(/\W+/g, '')}`}
        class="w-full text-xs font-mono p-3 rounded-lg bg-[var(--color-bg)] border border-[var(--color-border)]/50 text-[var(--color-text-muted)] resize-y"
        >{embedCode}</textarea
      >
      <button
        type="button"
        data-embed-copy={`embed-${creditPath.replace(/\W+/g, '')}`}
        class="mt-3 inline-flex items-center px-4 py-2 rounded-full bg-[var(--color-primary)] text-[var(--color-text-dark)] text-sm font-semibold hover:opacity-90 transition-opacity"
      >
        Copy embed code
      </button>
      <a
        href={src}
        download
        class="mt-3 ml-2 inline-flex items-center px-4 py-2 rounded-full border border-[var(--color-border)] text-sm font-semibold hover:border-[var(--color-primary)] transition-colors"
      >
        Download PNG
      </a>
    </div>
  </details>

  {printable && (
    <details class="mt-3 rounded-2xl border border-[var(--color-border)]/50 bg-[var(--color-surface)] overflow-hidden">
      <summary class="cursor-pointer select-none px-5 py-4 text-sm font-semibold hover:text-[var(--color-primary)] transition-colors">
        Printable version — white background, ink-friendly
      </summary>
      <div class="px-5 pb-5">
        <p class="text-sm text-[var(--color-text-muted)] mb-4">
          Same chart on a white background so it doesn't drink a cartridge of ink.
          Prints cleanly on US Letter or A4.
        </p>
        {/* A real <img>, not just a download link — otherwise it can never be indexed. */}
        <img
          src={printable.src}
          alt={`${alt} Printable white-background version.`}
          width={printable.width}
          height={printable.height}
          loading="lazy"
          decoding="async"
          class="w-full h-auto rounded-xl border border-white/8 bg-white"
        />
        <a
          href={printable.src}
          download
          class="mt-4 inline-flex items-center px-4 py-2 rounded-full bg-[var(--color-primary)] text-[var(--color-text-dark)] text-sm font-semibold hover:opacity-90 transition-opacity"
        >
          Download printable PNG
        </a>
      </div>
    </details>
  )}
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-embed-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const target = document.getElementById(btn.dataset.embedCopy!) as HTMLTextAreaElement | null;
      if (!target) return;
      try {
        await navigator.clipboard.writeText(target.value);
      } catch {
        target.select();
        document.execCommand('copy');
      }
      const original = btn.textContent;
      btn.textContent = 'Copied';
      setTimeout(() => {
        btn.textContent = original;
      }, 1800);
    });
  });
</script>

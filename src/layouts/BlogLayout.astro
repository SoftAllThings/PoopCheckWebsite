---
import PageLayout from './PageLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import RelatedPosts from '../components/blog/RelatedPosts.astro';
import { articleSchema } from '../utils/schema';
import { getCanonicalUrl, postImage } from '../utils/seo';
import { categoryLabel } from '../utils/categories';
import AppCTA from '../components/mdx/AppCTA.astro';
import { MID_ARTICLE_CTA } from '../utils/blog-cta';

interface Props {
  title: string;
  description: string;
  date: Date;
  updated?: Date;
  author?: string;
  category: string;
  slug: string;
  image?: string;
  imageAlt?: string;
}

const { title, description, date, updated, author, category, slug, image: explicitImage, imageAlt: explicitAlt } = Astro.props;

const image = postImage(slug, explicitImage);
const imageAlt = explicitAlt || title;

// MedicalWebPage type applies to all blog categories EXCEPT app-updates (which are product news, not medical content)
const isMedical = category !== 'app-updates';

const schema = articleSchema({
  title,
  description,
  url: getCanonicalUrl(Astro.url.pathname),
  image,
  imageAlt,
  datePublished: date.toISOString(),
  dateModified: updated?.toISOString(),
  author: author || 'PoopCheck Team',
  medical: isMedical,
});

const midCta = MID_ARTICLE_CTA[slug];

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<PageLayout
  seo={{
    title,
    description,
    type: 'article',
    image,
    imageAlt,
    publishedTime: date.toISOString(),
    modifiedTime: updated?.toISOString(),
    author: author || 'PoopCheck Team',
  }}
  schema={schema}
>
  <article class="py-12 md:py-20">
    <div class="max-w-3xl mx-auto px-5">
      <!-- Breadcrumbs -->
      <div class="mb-8">
        <Breadcrumbs
          items={[
            { label: 'Blog', href: '/poopcheck-blog/' },
            { label: categoryLabel(category), href: `/poopcheck-blog/category/${category}/` },
            { label: title, href: Astro.url.pathname },
          ]}
        />
      </div>

      <!-- Header -->
      <header class="mb-10">
        <div class="flex items-center gap-3 mb-4">
          <a
            href={`/poopcheck-blog/category/${category}/`}
            class="px-3 py-1 rounded-full text-xs font-semibold bg-[var(--color-primary)]/10 text-[var(--color-primary)] hover:bg-[var(--color-primary)]/20 transition-colors"
          >
            {categoryLabel(category)}
          </a>
          <span class="text-sm text-[var(--color-text-muted)]">{formattedDate}</span>
        </div>

        <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold leading-tight">{title}</h1>
        <p class="mt-4 text-lg text-[var(--color-text-muted)] leading-relaxed">{description}</p>

        <div class="mt-6 flex items-center gap-4 text-sm text-[var(--color-text-muted)]">
          <span>By {author || 'PoopCheck Team'}</span>
          {updated && (
            <span>Updated {updated.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
          )}
        </div>
      </header>

      {/*
        Hero renders only for a real illustration set in frontmatter. The
        generated card at postImage() is a title-on-background graphic built for
        social feeds, where it stands alone — on-page it sits directly under the
        <h1> and just repeats it. It stays in og:image and Article schema.
      */}
      {explicitImage && (
        <div class="mb-10 rounded-2xl overflow-hidden bg-[var(--color-surface)]">
          <img
            src={explicitImage}
            alt={imageAlt}
            class="w-full h-auto"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </div>
      )}

      <!-- Content -->
      <div class="prose prose-invert prose-lg max-w-none
        prose-headings:font-bold prose-headings:text-[var(--color-text)]
        prose-h2:text-2xl prose-h2:mt-12 prose-h2:mb-4
        prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3
        prose-p:text-[var(--color-text-muted)] prose-p:leading-relaxed
        prose-a:text-[var(--color-accent)] prose-a:no-underline hover:prose-a:underline
        prose-strong:text-[var(--color-text)]
        prose-code:text-[var(--color-primary)] prose-code:bg-[var(--color-surface)] prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded
        prose-blockquote:border-[var(--color-primary)] prose-blockquote:text-[var(--color-text-muted)]
        prose-li:text-[var(--color-text-muted)]
        prose-img:rounded-xl
      ">
        <slot />
      </div>

      {midCta && (
        <>
          {/*
            Mid-article CTA for the triage set. Cloned into the article body
            before a heading partway down, rather than imported into each MDX
            file — membership lives in src/utils/blog-cta.ts so re-triaging next
            quarter is a one-line edit.

            No JS means no mid CTA and the end CTA still renders, which is an
            acceptable floor for a CTA (not for content). The script runs inline
            immediately after .prose, so the headings are already parsed and
            insertion happens before anything below it paints — no layout shift.
          */}
          <template id="mid-article-cta">
            <AppCTA heading={midCta.heading} body={midCta.body} location="article_mid" />
          </template>
          <script is:inline>
            (() => {
              const tpl = document.getElementById('mid-article-cta');
              const prose = document.querySelector('.prose');
              if (!tpl || !prose) return;
              const heads = prose.querySelectorAll(':scope > h2');
              // Roughly 40% in, but never the first heading and never the last.
              const target = heads[Math.min(Math.max(1, Math.round(heads.length * 0.4)), heads.length - 1)];
              if (target) target.before(tpl.content.cloneNode(true));
            })();
          </script>
        </>
      )}

      <!--
        CTA sits directly after the article body, before Related Posts.
        It used to render last, which put a grid of exit links between the end
        of the read and the only conversion moment on the page.

        data-hide-sticky-cta suppresses MobileStickyCTA while this is on screen —
        blog posts don't render DownloadCTA, so without it the sticky bar
        overlapped the article footer.
      -->
      <div data-hide-sticky-cta>
        <AppCTA location="article_end" />
      </div>

      <!-- Author card -->
      <div class="mt-12 gradient-border p-6 flex items-start gap-4">
        <div class="w-12 h-12 rounded-full bg-gradient-to-br from-[var(--color-accent)] to-[var(--color-primary)] flex items-center justify-center shrink-0">
          <span class="text-lg font-bold text-[var(--color-text-dark)]">P</span>
        </div>
        <div>
          <div class="font-semibold">{author || 'PoopCheck Team'}</div>
          <p class="text-sm text-[var(--color-text-muted)] mt-1">
            The PoopCheck team is dedicated to making digestive health tracking accessible, accurate, and private for everyone.
          </p>
        </div>
      </div>

      <!-- Related -->
      <RelatedPosts currentSlug={Astro.url.pathname.split('/poopcheck-blog/')[1]?.replace(/\/$/, '') || ''} category={category} />
    </div>
  </article>
</PageLayout>

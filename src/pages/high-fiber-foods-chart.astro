---
import PageLayout from '../layouts/PageLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import EmbedChart from '../components/seo/EmbedChart.astro';
import { articleSchema, breadcrumbSchema, faqSchema } from '../utils/schema';
import { getCanonicalUrl, SITE } from '../utils/seo';
import fiberData from '../data/fiber-foods.json';
import charts from '../data/chart-images.json';

const url = getCanonicalUrl(Astro.url.pathname);
const title = 'High-Fiber Foods Chart: Grams Per Serving (Printable)';
const description =
  'A high-fiber foods chart ranking 20 everyday foods by grams of fiber per serving, with the daily target marked. Free printable version included.';

const CHART = charts.charts['high-fiber-foods-chart'];
const PRINT = charts.charts['high-fiber-foods-chart-printable'];
const ALT =
  'High-fiber foods chart ranking 20 foods by grams of dietary fiber per standard serving, from split peas at 16.3 g down to ground flaxseed at 2 g, with the 25 g daily target marked.';

const { targets, source, foods } = fiberData;
const groups = [...new Set(foods.map((f: any) => f.group))];
const max = Math.max(...foods.map((f: any) => f.grams));

const faqItems = [
  {
    question: 'How much fiber do I need per day?',
    answer: `The Adequate Intake for adults under 50 is ${targets.women} g a day for women and ${targets.men} g for men. Average intake in the US is around ${targets.averageIntake} g, so most people are short by a third to a half. Over 50, the targets drop slightly to 21 g and 30 g.`,
  },
  {
    question: 'What food has the most fiber?',
    answer:
      'Among everyday foods, cooked legumes lead by a wide margin. A cup of split peas provides 16.3 g, lentils 15.6 g, and black beans 15 g — each covering well over half a day’s target in one serving. Chia seeds are the densest by weight at 9.8 g per ounce.',
  },
  {
    question: 'Can one food meet my daily fiber target?',
    answer:
      'No, and that is the useful thing about seeing it charted. Even the highest food on this list gets you roughly two-thirds of the way. Meeting the target reliably means fiber at more than one meal — legumes at lunch, fruit and nuts as snacks, and whole grains rather than refined.',
  },
  {
    question: 'Does more fiber always mean better stool?',
    answer:
      'Up to a point. Fiber adds bulk and holds water, which moves stool toward the healthy Types 3 and 4 on the Bristol scale. But increasing intake abruptly, or increasing it without also drinking more water, commonly causes bloating, gas and firmer stool rather than softer. Add roughly 5 g a week and increase fluids alongside it.',
  },
  {
    question: 'Soluble or insoluble fiber — which do I need?',
    answer:
      'Both, and most whole foods contain a mix. Soluble fiber (oats, beans, apples, psyllium) forms a gel that softens stool and feeds gut bacteria. Insoluble fiber (wheat bran, vegetable skins, nuts) adds bulk and speeds transit. Eating a range of plants covers both without needing to track them separately.',
  },
];

const schema = [
  articleSchema({
    title,
    description,
    url,
    image: CHART.src,
    imageAlt: ALT,
    images: [{ url: PRINT.src, width: PRINT.width, height: PRINT.height, caption: `${ALT} Printable version.` }],
    datePublished: '2026-08-12T00:00:00Z',
    dateModified: '2026-08-12T00:00:00Z',
    author: 'PoopCheck Team',
    medical: true,
  }),
  breadcrumbSchema([
    { name: 'Home', url: `${SITE.url}/` },
    { name: 'High-Fiber Foods Chart', url },
  ]),
  faqSchema(faqItems),
];
---

<PageLayout seo={{ title, description, type: 'article', image: CHART.src, imageAlt: ALT }} schema={schema}>
  <article class="py-12 md:py-20">
    <div class="max-w-4xl mx-auto px-5">
      <div class="mb-8">
        <Breadcrumbs items={[{ label: 'High-Fiber Foods Chart', href: '/high-fiber-foods-chart/' }]} />
      </div>

      <header class="mb-10 text-center">
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold leading-tight">
          High-Fiber Foods Chart
        </h1>
        <p class="mt-4 text-lg text-[var(--color-text-muted)] leading-relaxed max-w-2xl mx-auto">
          Twenty everyday foods ranked by grams of fiber per serving, with the daily
          target marked so you can see how far one serving actually gets you. Most
          people eat about {targets.averageIntake} g a day and need {targets.women}–{targets.men}.
        </p>
      </header>

      <EmbedChart
        src={CHART.src}
        alt={ALT}
        width={CHART.width}
        height={CHART.height}
        title="High-Fiber Foods Chart"
        caption={`Grams of dietary fiber per standard serving. Values from ${source.label}.`}
        creditPath="/high-fiber-foods-chart/"
        eager={true}
        printable={{ src: PRINT.src, width: PRINT.width, height: PRINT.height }}
      />

      <h2 class="text-2xl font-bold mb-6 mt-16">The full list, by food group</h2>

      {groups.map((g) => (
        <div class="mb-8">
          <h3 class="text-lg font-bold mb-3 text-[var(--color-primary)]">{g}</h3>
          <div class="rounded-2xl border border-[var(--color-border)]/50 bg-[var(--color-surface)] overflow-hidden">
            {foods
              .filter((f: any) => f.group === g)
              .map((f: any, i: number) => (
                <div
                  class={`flex items-center gap-4 px-5 py-3.5 ${i > 0 ? 'border-t border-[var(--color-border)]/40' : ''}`}
                >
                  <div class="flex-1 min-w-0">
                    <div class="font-semibold">{f.name}</div>
                    <div class="text-xs text-[var(--color-text-muted)]">{f.serving}</div>
                  </div>
                  <div class="hidden sm:block w-1/3">
                    <div class="h-2.5 rounded-full bg-[var(--color-bg)] overflow-hidden">
                      <div
                        class="h-full rounded-full bg-[var(--color-primary)]"
                        style={`width: ${Math.round((f.grams / max) * 100)}%;`}
                      ></div>
                    </div>
                  </div>
                  <div class="w-16 text-right font-bold tabular-nums">{f.grams} g</div>
                </div>
              ))}
          </div>
        </div>
      ))}

      <div class="prose prose-invert prose-lg max-w-none mt-16
        prose-headings:font-bold prose-headings:text-[var(--color-text)]
        prose-h2:text-2xl prose-h2:mt-12 prose-h2:mb-4
        prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3
        prose-p:text-[var(--color-text-muted)] prose-p:leading-relaxed
        prose-a:text-[var(--color-accent)] prose-a:no-underline hover:prose-a:underline
        prose-strong:text-[var(--color-text)]
        prose-li:text-[var(--color-text-muted)]
      ">
        <h2>Increase it slowly</h2>
        <p>
          The most common mistake is going from {targets.averageIntake} g to {targets.women} g
          overnight. That reliably produces bloating, gas and firmer stool — the exact
          opposite of the intended effect. Add roughly 5 g a week, and increase water
          at the same time. Fiber works by holding water; without the water it just
          adds bulk.
        </p>

        <h2>How this shows up in the toilet</h2>
        <p>
          Adequate fiber pushes stool toward Types 3 and 4 on the{' '}
          <a href="/bristol/">Bristol Stool Chart</a> — formed, smooth, easy to pass.
          Too little tends toward Types 1 and 2. If you are adding fiber and drifting
          toward Type 1 rather than away from it, the usual culprit is fluid intake
          rather than the fiber itself.
        </p>

        <h2>If fiber makes your symptoms worse</h2>
        <p>
          For some people — particularly with IBS — the high-fiber foods on this list
          are also high in FODMAPs, and more fiber means more bloating rather than
          less. Beans, apples and wheat are common triggers. If that is your pattern,
          the <a href="/low-fodmap-food-list/">low FODMAP food list</a> is the more
          useful starting point.
        </p>

        <p><em>
          Values are rounded and vary with variety, ripeness and preparation. This page
          is general information, not dietary advice for a specific medical condition.
        </em></p>

        <h2>FAQ</h2>
        {faqItems.map((f) => (
          <>
            <h3>{f.question}</h3>
            <p>{f.answer}</p>
          </>
        ))}

        <h2>Source</h2>
        <p><a href={source.url} rel="nofollow noopener" target="_blank">{source.label}</a>. {targets.note}</p>
      </div>
    </div>
  </article>
</PageLayout>
